VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Generate a VAPID key pair for web push and put the public key here.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Optional client analytics. Keep false until telemetry tables are deployed.
VITE_ENABLE_ANALYTICS=false

# Canonical public JYC origin for runtime metadata and build-time route/sitemap generation.
VITE_SITE_URL=https://jyc-website-eight.vercel.app

# Canonical origin shared by runtime metadata, route shells and sitemap. Do not use the JAI custom domain.
VITE_CANONICAL_ORIGIN=https://jyc-website-eight.vercel.app

# React Bits Pro registry authentication (never commit the real key).
# Add the real value only to .env.local or your deployment environment.
REACTBITS_LICENSE_KEY=

# V47 JYC NOW server-only connectors (never prefix these with VITE_)
META_ACCESS_TOKEN=
YOUTUBE_API_KEY=
LINKEDIN_ACCESS_TOKEN=
JYC_LINKEDIN_VERSION=202609
JYC_INSTAGRAM_ACCOUNTS={"JYC":"<instagram-professional-user-id>"}
JYC_YOUTUBE_CHANNELS={}
JYC_RSS_FEEDS={}
JYC_MANUAL_UPDATES=[]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JYC_SYNC_SECRET=

# Google Search Console verification token from the JYC property. Leave empty until verified.
VITE_GOOGLE_SITE_VERIFICATION=
